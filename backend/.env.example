PORT=5000
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
DB_FILE=./data/oper-in.db
UPLOAD_DIR=./uploads
# Isi jika API diakses lewat domain publik, mis. https://api.operin.example
PUBLIC_URL=
# Zona waktu untuk menentukan barang "ditutup"
APP_TZ=Asia/Jakarta
CORS_ORIGIN=*

# Akun admin dibuat otomatis saat server dijalankan (kata sandi minimal 6 karakter)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@operin.local
ADMIN_PASSWORD=admin123
